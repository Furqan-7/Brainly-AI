# ── Required ──────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/brainly
DIRECT_URL=postgresql://user:password@host:5432/brainly
JWT_TOKEN=change-me-to-a-long-random-string
# Comma-separated origins allowed to call the API with cookies
CLIENT_URL=http://localhost:3000

# AI providers
NOMIC_API_KEY=        # embeddings (nomic-embed-text-v1.5)
GROQ_API_KEY=         # answers, HyDE, summaries/tags, Whisper transcription
GEMINI_API_KEY=       # image description + OCR for scanned PDFs
COHERE_API_KEY=       # optional: reranking (skipped when empty)

# ── Optional ──────────────────────────────────────────────
# OAuth (each provider is only enabled when its client id is set)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3001/auth/github/callback

# Database driver: "neon" (serverless) or "pg"; guessed from DATABASE_URL when unset
DB_DRIVER=

# File storage: S3 / Cloudflare R2 when S3_BUCKET is set, local disk otherwise
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=           # e.g. https://<account>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Cookies: defaults to SameSite=None; Secure in production (frontend and API on different sites)
COOKIE_SAMESITE=

# Background worker
WORKER_CONCURRENCY=2
DISABLE_WORKER=false
YTDLP_PATH=yt-dlp

# Retrieval tuning
MIN_RERANK_SCORE=0.1
MAX_VECTOR_DISTANCE=0.6
GRAPH_MIN_SIMILARITY=0.55
