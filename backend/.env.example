# ── Required ──────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/brainly
DIRECT_URL=postgresql://user:password@host:5432/brainly
JWT_TOKEN=change-me-to-a-long-random-string
# Comma-separated origins allowed to call the API with cookies
CLIENT_URL=http://localhost:3000

# AI providers
NOMIC_API_KEY=        # embeddings (nomic-embed-text-v1.5)
GROQ_API_KEY=         # answers, HyDE, summaries/tags, Whisper transcription
GEMINI_API_KEY=       # image description + OCR for scanned PDFs
COHERE_API_KEY=       # optional: reranking (skipped when empty)

# ── Optional ──────────────────────────────────────────────
# OAuth (each provider is only enabled when its client id is set)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Point OAuth callbacks at the web app's /backend proxy so the session cookie is set on its domain
GOOGLE_CALLBACK_URL=http://localhost:3000/backend/auth/google/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3000/backend/auth/github/callback

# Database driver: "neon" (serverless) or "pg"; guessed from DATABASE_URL when unset
DB_DRIVER=

# File storage: S3 / Cloudflare R2 when S3_BUCKET is set, local disk otherwise
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=           # e.g. https://<account>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Cookies: the web app proxies the API through its own domain (/backend), so the session
# cookie is first-party. Lax is recommended; defaults to None; Secure in production.
COOKIE_SAMESITE=lax

# Proxies between the visitor and this API, for correct client IPs in rate limiting.
# Behind the web app's /backend proxy on Vercel plus a host like Render, use 2.
TRUST_PROXY=1

# Background worker
WORKER_CONCURRENCY=2
DISABLE_WORKER=false
YTDLP_PATH=yt-dlp

# Retrieval tuning
MIN_RERANK_SCORE=0.1
MAX_VECTOR_DISTANCE=0.6
GRAPH_MIN_SIMILARITY=0.55
