# ── Required ──────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/brainly
DIRECT_URL=postgresql://user:password@host:5432/brainly
JWT_TOKEN=change-me-to-a-long-random-string
# Comma-separated origins allowed to call the API with cookies
CLIENT_URL=http://localhost:3000

# AI providers
NOMIC_API_KEY=        # embeddings (nomic-embed-text-v1.5)
GROQ_API_KEY=         # answers, HyDE, summaries/tags, Whisper transcription
# Optional: the model that writes answers, and the one used if Groq retires it
# GROQ_ANSWER_MODEL=qwen/qwen3.8-27b
# GROQ_ANSWER_FALLBACK_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=       # image description + OCR for scanned PDFs
COHERE_API_KEY=       # optional: reranking (skipped when empty)

# ── Optional ──────────────────────────────────────────────
# OAuth (each provider is only enabled when its client id is set)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# OAuth callbacks may point at the API or at the web app's /backend proxy; either way the
# sign-in is handed to the web app (CLIENT_URL) so the session cookie lands on its domain
GOOGLE_CALLBACK_URL=http://localhost:3000/backend/auth/google/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3000/backend/auth/github/callback

# Email (password reset and email verification). Use one of:
#   RESEND_API_KEY  https://resend.com (free tier); verify your domain there to send from it
#   SMTP_URL        any SMTP server, e.g. Gmail with an app password:
#                   smtps://you%40gmail.com:app-password@smtp.gmail.com:465
# With neither, emails are printed to the log in development and not sent in production.
RESEND_API_KEY=
SMTP_URL=
EMAIL_FROM="Brainly <hello@brainlyai.me>"

# Database driver: "neon" (serverless) or "pg"; guessed from DATABASE_URL when unset
DB_DRIVER=

# File storage: S3 / Cloudflare R2 when S3_BUCKET is set, local disk otherwise
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=           # e.g. https://<account>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Cookies: the web app proxies the API through its own domain (/backend), so the session
# cookie is first-party and SameSite=Lax (the default) works. The Secure flag follows whether
# the visitor's page is on HTTPS, so plain-HTTP local and LAN setups keep their session.
COOKIE_SAMESITE=lax

# Proxies between the visitor and this API, for correct client IPs in rate limiting.
# Behind the web app's /backend proxy on Vercel plus a host like Render, use 2.
TRUST_PROXY=1

# Background worker
WORKER_CONCURRENCY=2
DISABLE_WORKER=false
YTDLP_PATH=yt-dlp

# Retrieval tuning
# Speed: how long a search waits for each AI helper before going ahead without it
HYDE_TIMEOUT_MS=1500      # sample answer used to find better matches
REWRITE_TIMEOUT_MS=2000   # rewriting follow-ups like "show me more like that"
RERANK_TIMEOUT_S=2.5      # Cohere re-ranking
MIN_RERANK_SCORE=0.1
MAX_VECTOR_DISTANCE=0.6
GRAPH_MIN_SIMILARITY=0.55
