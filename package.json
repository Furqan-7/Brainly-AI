{
  "name": "brainly-ai",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"pnpm --filter frontend dev\" \"pnpm --filter backend dev\"",
    "build": "pnpm --filter db db:generate && pnpm --filter db build && pnpm --filter db migrate:deploy && pnpm --filter backend build",
    "test": "pnpm --filter backend test",
    "lint": "pnpm --filter frontend lint",
    "build:extension": "node extension/build.mjs"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "packageManager": "pnpm@10.28.0"
}
