{
  "manifest_version": 3,
  "name": "Brainly AI — Save to Brain",
  "version": "1.3.0",
  "description": "Save any page, link, video, reel or text selection to your Brainly second brain in one click. Brainly names, summarises and tags it for you.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Save to Brainly",
    "default_icon": {
      "128": "icon.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "options.html",
  "permissions": [
    "activeTab",
    "contextMenus",
    "storage",
    "notifications"
  ],
  "host_permissions": [
    "https://brainlyai.me/*",
    "https://brainly-ai-frontend.vercel.app/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://brainlyai.me/*",
        "https://brainly-ai-frontend.vercel.app/*",
        "http://localhost:3000/*"
      ],
      "js": [
        "connect.js"
      ],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "128": "icon.png"
  }
}
