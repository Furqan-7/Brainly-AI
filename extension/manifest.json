{
  "manifest_version": 3,
  "name": "Brainly AI — Save to Brain",
  "version": "1.0.0",
  "description": "Save any page, link, video, reel or text selection to your Brainly second brain, and search it.",
  "action": { "default_popup": "popup.html", "default_title": "Save to Brainly" },
  "background": { "service_worker": "background.js", "type": "module" },
  "options_page": "options.html",
  "permissions": ["activeTab", "contextMenus", "storage", "notifications"],
  "optional_host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
  "icons": { "128": "icon.png" }
}
