# URL of the Brainly API (Express backend). Requests are proxied through /backend on this site.
BACKEND_URL=http://localhost:3001

# Public address of this site, used for link previews on X, LinkedIn, Slack… (absolute og:image URLs).
# On Vercel the production domain is used automatically.
NEXT_PUBLIC_SITE_URL=https://brainly-ai-frontend.vercel.app

# Website previews on saved links (/api/preview) use headless Chrome. On Vercel/Linux the bundled
# serverless Chromium is used automatically; on Windows/macOS your installed Chrome is found, or set its path:
# CHROME_EXECUTABLE_PATH="C:\Program Files\Google\Chrome\Application\chrome.exe"
