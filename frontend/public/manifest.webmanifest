{
  "name": "Brainly AI",
  "short_name": "Brainly",
  "description": "Your second brain — save anything, find it with AI.",
  "start_url": "/chat",
  "display": "standalone",
  "background_color": "#faf5f2",
  "theme_color": "#faf5f2",
  "icons": [
    {
      "src": "/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ],
  "share_target": {
    "action": "/share",
    "method": "GET",
    "params": {
      "title": "share_title",
      "text": "share_text",
      "url": "share_url"
    }
  },
  "id": "/chat"
}
