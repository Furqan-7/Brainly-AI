generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

model User {
  id        Int        @id @default(autoincrement())
  username  String
  email     String     @unique
  password  String?
  createdAt DateTime   @default(now())
  isPremium Boolean    @default(false)
  accounts  Account[]
  memories  Memories[]
}

model Account {
  id                Int     @id @default(autoincrement())
  userId            Int
  provider          String
  providerAccountId String
  accessToken       String?
  refreshToken      String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Memories {
  id          Int         @id @default(autoincrement())
  userId      Int
  type        ContentType
  title       String
  source_url  String?
  file_path   String?
  status      Status      @default(pending)
  metadata    Json?
  createdAt   DateTime    @default(now())
  note        String?
  granularity Granularity @default(long_form)
  chunks      Chunks[]
  user        User        @relation(fields: [userId], references: [id])
}

model Chunks {
  id          Int                      @id @default(autoincrement())
  MemoryId    Int
  content     String
  chunk_index Int
  createdAt   DateTime                 @default(now())
  metadata    Json?
  token_count Int?
  embedding   Unsupported("vector")?
  content_tsv Unsupported("tsvector")? @default(dbgenerated("to_tsvector('english'::regconfig, content)"))
  Memory      Memories                 @relation(fields: [MemoryId], references: [id])

  @@index([MemoryId])
  @@index([content_tsv], map: "chunks_content_tsv_idx", type: Gin)
  @@index([embedding], map: "chunks_embedding_idx")
}

model ApiUsage {
  id         Int    @id @default(autoincrement())
  service    String
  month_year String
  call_count Int    @default(0)

  @@unique([service, month_year])
}

enum ContentType {
  pdf
  url
  youtube
  tweet
  note
  image
}

enum Status {
  pending
  processing
  ready
  failed
}

enum Granularity {
  long_form
  atomic
}
