generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

model User {
  id        Int        @id @default(autoincrement())
  username  String
  email     String     @unique
  password  String?
  createdAt DateTime   @default(now())
  isPremium Boolean    @default(false)
  // Set once the user proves they own the email (link in the verification email, password
  // reset, or Google / GitHub sign-in)
  emailVerified DateTime?
  // Bumped by "sign out everywhere" and password resets: tokens carrying an older version stop working
  tokenVersion  Int       @default(0)
  accounts  Account[]
  devices   Device[]
  memories  Memories[]
  collections   Collection[]
  conversations Conversation[]
  usage         UserUsage[]
}

model Account {
  id                Int     @id @default(autoincrement())
  userId            Int
  provider          String
  providerAccountId String
  accessToken       String?
  refreshToken      String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

/** A signed-in browser extension (or a copied token). Deleting the row signs that device out. */
model Device {
  id         String   @id
  userId     Int
  name       String
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Memories {
  id          Int         @id @default(autoincrement())
  userId      Int
  type        ContentType
  title       String
  source_url  String?
  file_path   String?
  status      Status      @default(pending)
  metadata    Json?
  createdAt   DateTime    @default(now())
  note        String?
  granularity Granularity @default(long_form)
  // AI-generated on ingest; user tags and auto tags share this list
  summary     String?
  tags        String[]    @default([])
  starred     Boolean     @default(false)
  archived    Boolean     @default(false)
  // Background job bookkeeping (see backend/src/worker.ts)
  attempts      Int       @default(0)
  nextAttemptAt DateTime?
  error         String?
  updatedAt     DateTime  @default(now()) @updatedAt
  // Spaced repetition for the "Rediscover" digest
  nextReviewAt   DateTime?
  reviewInterval Int       @default(1)
  chunks      Chunks[]
  collections Collection[]
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, source_url])
  @@index([status, nextAttemptAt])
}

model Collection {
  id          Int        @id @default(autoincrement())
  userId      Int
  name        String
  description String?
  // Set when the owner shares the collection publicly
  shareSlug   String?    @unique
  createdAt   DateTime   @default(now())
  memories    Memories[]
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
}

model Conversation {
  id        Int       @id @default(autoincrement())
  userId    Int
  title     String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
  messages  Message[]
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
}

model Message {
  id             Int          @id @default(autoincrement())
  conversationId Int
  role           String
  content        String
  sources        Json?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model UserUsage {
  id         Int    @id @default(autoincrement())
  userId     Int
  day        String
  chat_count Int    @default(0)
  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day])
}

model Chunks {
  id          Int                      @id @default(autoincrement())
  MemoryId    Int
  content     String
  chunk_index Int
  createdAt   DateTime                 @default(now())
  metadata    Json?
  token_count Int?
  embedding   Unsupported("vector")?
  content_tsv Unsupported("tsvector")? @default(dbgenerated("to_tsvector('english'::regconfig, content)"))
  Memory      Memories                 @relation(fields: [MemoryId], references: [id], onDelete: Cascade)

  @@index([MemoryId])
  @@index([content_tsv], map: "chunks_content_tsv_idx", type: Gin)
  @@index([embedding], map: "chunks_embedding_idx")
}

model ApiUsage {
  id         Int    @id @default(autoincrement())
  service    String
  month_year String
  call_count Int    @default(0)

  @@unique([service, month_year])
}

enum ContentType {
  pdf
  url
  youtube
  tweet
  note
  image
  reel
  tiktok
  audio
}

enum Status {
  pending
  processing
  ready
  failed
}

enum Granularity {
  long_form
  atomic
}
